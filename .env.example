# Server port (default 3000)
PORT=3000
# Public https address Vapi calls back; npm run live sets it from the tunnel
PUBLIC_URL=
# Vapi private key, for syncing the assistant
VAPI_PRIVATE_KEY=
# Optional Deepgram credential for Vapi
DEEPGRAM_API_KEY=
# Set to 0 to disable the Jev router (every turn is a plain continuation)
JEV_ENABLED=
VAPI_CUSTOM_LLM_SECRET=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
REPLY_MODEL=
BACKGROUND_MODEL=
